Options -Indexes

# Bloquear acceso directo a archivos sensibles
<FilesMatch "\.(sql|bak|log|md|txt|zip)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a archivos ocultos del sistema
<FilesMatch "^\.htaccess$">
    Require all denied
</FilesMatch>

<Files ".env">
    Require all denied
</Files>
SetEnv SYNC_TOKEN "b481d30b0bf4f391e36d84decfbf0e83ac468eee355c31a006319c35f8b8184e"